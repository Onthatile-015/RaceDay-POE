@model List<RaceDay.Mvc.Models.MyEnrolment>
@{
    ViewData["Title"] = "My enrolments";
}

<div class="page-header">
    <h1 class="mb-0">My enrolments</h1>
    <p class="text-muted mb-0">Every event you've entered, and where each entry stands.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="card p-4 text-center">
        <p class="text-muted">You haven't enrolled for any events yet.</p>
        <div><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse events</a></div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Event</th><th>Type</th><th>Event date</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                            <td>@e.EventType</td>
                            <td>@e.EventDate.ToString("d MMM yyyy")</td>
                            <td>@e.CategoryName</td>
                            <td>@e.EnrolmentDate.ToString("d MMM yyyy")</td>
                            <td><span class="status-badge @StatusDisplay.CssClass(e.Status)">@StatusDisplay.Label(e.Status)</span></td>
                            <td class="text-end">
                                @if (e.Status == "Active" && e.EventDate > DateTime.Now)
                                {
                                    <form asp-action="Withdraw" asp-route-id="@e.EnrolmentId" method="post" class="d-inline"
                                          onsubmit="return confirm('Withdraw from this event?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Withdraw</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
