@model RaceDay.Mvc.ViewModels.CategoriesViewModel
@{ ViewData["Title"] = "Categories"; }

<div class="page-header">
  <h1 class="mb-0">Categories</h1>
  <p class="text-muted mb-0">@Model.EventName · <a asp-action="Events">Back to my events</a></p>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card"><div class="card-body">
      @if (!Model.Categories.Any())
      {
        <p class="text-muted mb-0">No categories yet. Add one using the form, for example Under 20, Senior, 10km or 21km.</p>
      }
      else
      {
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Category</th><th>Max participants</th><th>Entry fee</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Categories)
            {
              <tr>
                <td>@c.Name</td>
                <td>@c.MaxParticipants</td>
                <td>R @c.EntryFee.ToString("N2")</td>
                <td class="text-end">
                  <a asp-action="EditCategory" asp-route-eventId="@Model.EventId" asp-route-id="@c.CategoryId" class="btn btn-outline-primary btn-sm">Edit</a>
                  <form asp-action="DeleteCategory" asp-route-eventId="@Model.EventId" asp-route-id="@c.CategoryId" method="post" class="d-inline"
                        onsubmit="return confirm('Delete this category?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
            }
            </tbody>
          </table>
        </div>
      }
    </div></div>
  </div>

  <div class="col-lg-5">
    <div class="card"><div class="card-body">
      <h4>Add a category</h4>
      <form asp-action="AddCategory" asp-route-id="@Model.EventId" method="post">
        <div class="mb-3">
          <label asp-for="NewCategory.Name" class="form-label"></label>
          <input asp-for="NewCategory.Name" class="form-control" placeholder="e.g. 10km, Under 20, Senior" />
          <span asp-validation-for="NewCategory.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
          <label asp-for="NewCategory.MaxParticipants" class="form-label"></label>
          <input asp-for="NewCategory.MaxParticipants" class="form-control" />
          <span asp-validation-for="NewCategory.MaxParticipants" class="text-danger"></span>
        </div>
        <div class="mb-3">
          <label asp-for="NewCategory.EntryFee" class="form-label"></label>
          <input asp-for="NewCategory.EntryFee" class="form-control" />
          <span asp-validation-for="NewCategory.EntryFee" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Add category</button>
      </form>
    </div></div>
  </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
