@model RaceDay.Mvc.ViewModels.EventFormViewModel
@{
  var isEdit = Model.EventId.HasValue;
  ViewData["Title"] = isEdit ? "Edit event" : "New event";
}

<div class="page-header"><h1 class="mb-0">@ViewData["Title"]</h1></div>

<div class="card"><div class="card-body">
  
  <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
      <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
      </div>
      <div class="col-md-4">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
          <option value="Run">Run</option>
          <option value="Walk">Walk</option>
          <option value="Cycle">Cycle</option>
        </select>
      </div>
      <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
      </div>
      <div class="col-md-8">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
      </div>
      <div class="col-md-4">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
      </div>
      <div class="col-12">
     <label class="form-label">Event banner image</label>
            @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
            {
           <div class="mb-2"><img src="@Model.BannerImageUrl" alt="Current banner" style="max-height:120px;border-radius:.5rem" /></div>
        }
        <input type="file" name="bannerFile" accept="image/*" class="form-control" />
      <div class="form-text">JPG, PNG, WEBP or GIF, up to 5 MB. Optional.</div>
      </div>
        <input type="hidden" asp-for="BannerImageUrl" />
      @if (isEdit)
      {
        <div class="col-md-4">
          <label asp-for="Status" class="form-label"></label>
          <select asp-for="Status" class="form-select">
            <option value="Upcoming">Upcoming</option>
            <option value="Ongoing">Ongoing</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
          </select>
        </div>
      }
    </div>
    <div class="mt-4">
      <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button>
      <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
