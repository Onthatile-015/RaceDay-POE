@model RaceDay.Mvc.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="page-header">
  <h1 class="mb-0">Organiser dashboard</h1>
  <p class="text-muted mb-0">Welcome back, @User.Identity?.Name</p>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4"><div class="card p-3"><div class="text-muted">Events created</div><div class="display-6">@Model.TotalEvents</div></div></div>
  <div class="col-md-4"><div class="card p-3"><div class="text-muted">Total enrolments</div><div class="display-6">@Model.TotalEnrolments</div></div></div>
  <div class="col-md-4"><div class="card p-3"><div class="text-muted">Upcoming events</div><div class="display-6">@Model.UpcomingCount</div></div></div>
</div>

@if (Model.NextEvent != null)
{
  <div class="alert alert-dark">Next event: <strong>@Model.NextEvent.Name</strong> on @Model.NextEvent.EventDate.ToString("dddd, d MMMM yyyy")</div>
}

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0">Your events</h4>
      <a asp-action="Events" class="btn btn-primary btn-sm">Manage events</a>
    </div>
    @if (!Model.Events.Any())
    {
      <p class="text-muted mb-0">You haven't created any events yet.</p>
    }
    else
    {
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Event</th><th>Type</th><th>Date</th><th>Distance</th><th>Enrolments</th><th>Status</th></tr></thead>
          <tbody>
          @foreach (var e in Model.Events)
          {
            <tr>
              <td>@e.Name</td>
              <td>@e.EventType</td>
              <td>@e.EventDate.ToString("d MMM yyyy")</td>
              <td>@e.DistanceKm km</td>
              <td><span class="badge bg-dark">@e.TotalEnrolments</span></td>
              <td>@e.Status</td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>