@model RaceDay.Mvc.ViewModels.EventEnrolmentViewModel
@{ ViewData["Title"] = "Results"; }

<div class="page-header">
  <h1 class="mb-0">Enter results</h1>
  <p class="text-muted mb-0">@Model.EventName · @Model.EventDate.ToString("d MMM yyyy") · <a asp-action="Events">Back to my events</a></p>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }
@if (Model.EventDate > DateTime.Now)
{
  <div class="alert alert-info">This event hasn't taken place yet. Results are normally captured after the event concludes.</div>
}

@if (!Model.Enrolments.Any())
{
  <div class="card p-4 text-center text-muted">Nobody has enrolled for this event, so there are no results to capture.</div>
}
else
{
  <div class="card"><div class="card-body table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Participant</th><th>Category</th><th>Finish time (hh:mm:ss)</th><th>Position</th><th></th></tr></thead>
      <tbody>
      @foreach (var e in Model.Enrolments.OrderBy(x => x.CategoryName).ThenBy(x => x.ParticipantName))
      {
        var formId = $"result-{e.EnrolmentId}";
        var time = e.FinishTime.HasValue ? e.FinishTime.Value.ToString(@"hh\:mm\:ss") : "";
        <tr>
          <td>@e.ParticipantName</td>
          <td>@e.CategoryName</td>
          <td><input type="time" step="1" name="FinishTime" value="@time" form="@formId" class="form-control" required /></td>
          <td><input type="number" min="1" name="Position" value="@e.Position" form="@formId" class="form-control" style="max-width:110px" required /></td>
          <td class="text-end">
            <form id="@formId" asp-action="SaveResult" method="post" class="d-inline">
              <input type="hidden" name="eventId" value="@Model.EventId" />
              <input type="hidden" name="EnrolmentId" value="@e.EnrolmentId" />
              <input type="hidden" name="hasResult" value="@(e.ResultId.HasValue ? "true" : "false")" />
              @if (e.ResultId.HasValue) { <span class="status-badge status-confirmed me-1">Published</span> }
              <button type="submit" class="btn btn-primary btn-sm">@(e.ResultId.HasValue ? "Update" : "Save")</button>
            </form>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div></div>
}
