@model RaceDay.Mvc.ViewModels.EventEnrolmentViewModel
@{ ViewData["Title"] = "Enrolments"; }

<div class="page-header">
  <h1 class="mb-0">Enrolments</h1>
  <p class="text-muted mb-0">@Model.EventName · @Model.EventDate.ToString("d MMM yyyy") · <a asp-action="Events">Back to my events</a></p>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="badge bg-dark fs-6">@Model.Enrolments.Count participant(s)</span>
  <a asp-action="Results" asp-route-id="@Model.EventId" class="btn btn-primary">Enter results</a>
</div>

@if (!Model.Enrolments.Any())
{
  <div class="card p-4 text-center text-muted">Nobody has enrolled for this event yet.</div>
}
else
{
  <div class="card"><div class="card-body table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Participant</th><th>Category</th><th>Enrolled on</th><th>Status</th></tr></thead>
      <tbody>
      @foreach (var e in Model.Enrolments.OrderBy(x => x.CategoryName).ThenBy(x => x.ParticipantName))
      {
        <tr>
          <td>@e.ParticipantName</td>
          <td>@e.CategoryName</td>
          <td>@e.EnrolmentDate.ToString("d MMM yyyy")</td>
          <td><span class="status-badge @StatusDisplay.CssClass(e.Status)">@StatusDisplay.Label(e.Status)</span></td>
        </tr>
      }
      </tbody>
    </table>
  </div></div>
}
