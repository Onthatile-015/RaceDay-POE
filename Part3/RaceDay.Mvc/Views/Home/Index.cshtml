@model RaceDay.Mvc.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<div class="page-header">
    <h1 class="mb-0">Upcoming events</h1>
    <p class="text-muted mb-0">Find your next run, walk or ride.</p>
</div>

<form method="get" asp-action="Index" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">Search</label><input asp-for="Filter.Search" class="form-control" placeholder="Event name" /></div>
        <div class="col-md-2">
            <label class="form-label">Type</label>
            <select asp-for="Filter.EventType" class="form-select">
                <option value="">All</option>
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
        <div class="col-md-2"><label class="form-label">City</label><input asp-for="Filter.City" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">From</label><input asp-for="Filter.From" type="date" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">To</label><input asp-for="Filter.To" type="date" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Max km</label><input asp-for="Filter.MaxDistanceKm" class="form-control" /></div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="card p-4 text-center text-muted">No events match your search. Try changing or clearing the filters.</div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(e.BannerImageUrl))
                    {
                        <img src="@e.BannerImageUrl" class="event-banner" alt="@e.Name banner" />
                    }
                    else
                    {
                        <div class="event-banner event-banner-placeholder"><span>@e.EventType.ToUpper()</span></div>
                    }
                    <div class="card-body d-flex flex-column">
                        <span class="badge type-badge mb-2 align-self-start">@e.EventType</span>
                        <h4>@e.Name</h4>
                        <p class="text-muted mb-1">@e.EventDate.ToString("ddd, d MMM yyyy · HH:mm")</p>
                        <p class="mb-3">@e.DistanceKm km@(string.IsNullOrEmpty(e.City) ? "" : " · " + e.City)</p>
                        <a asp-action="Details" asp-route-id="@e.EventId" class="btn btn-primary mt-auto">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}